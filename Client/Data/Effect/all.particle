	material jia_mo01
	particle_width 10
	particle_height 10
	cull_each false
	renderer billboard
	sorted false
	local_space true
	iteration_interval 0
	nonvisible_update_timeout 0

	billboard_type point
	billboard_origin center
	billboard_rotation_type texcoord
	common_direction 0 0 1
	common_up_vector 0 1 0
	point_rendering false
	accurate_facing false
	speed_relatived_size_factor 0.01

	emitter Box
	{
		angle 0
		colour 1 1 1 1
		colour_range_start 1 1 1 1
		colour_range_end 1 1 1 1
		direction 0 1 0
		emission_rate 2
		position 0 0 0
		velocity 1
		velocity_min 1
		velocity_max 1
		time_to_live 2
		time_to_live_min 2
		time_to_live_max 2
		duration 0
		duration_min 0
		duration_max 0
		repeat_delay 0
		repeat_delay_min 0
		repeat_delay_max 0
		width 40
		height 40
		depth 40
	}

	affector ColourFading
	{
		colour0 0 0 0 1
		time0 0
		colour1 0.266667 0.615686 1 1
		time1 0.2
		colour2 0 0 0 1
		time2 1
		colour3 0.5 0.5 0.5 0
		time3 1
		colour4 0.5 0.5 0.5 0
		time4 1
		colour5 0.5 0.5 0.5 0
		time5 1
		repeat_times 1
		opacity 1
		fade_in_time 0
		fade_out_time 1
	}
	affector ScaleInterpolator
	{
		uniform_size true
		width_range_start 5
		width_range_end 10
		height_range_start 10
		height_range_end 10
		use_constant_scale false
		constant_scale 1 1 1
		use_interpolated_scale false
		scale0 1 1 1
		time0 1
		scale1 1 1 1
		time1 1
		scale2 1 1 1
		time2 1
		scale3 1 1 1
		time3 1
		scale4 1 1 1
		time4 1
		scale5 1 1 1
		time5 1
		repeat_times 1
	}

	affector Rotator
	{
		rotation_speed_range_start 80
		rotation_speed_range_end 80
		rotation_range_start 0
		rotation_range_end 0
	}
}


