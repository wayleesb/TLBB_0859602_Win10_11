	material wq_dadao10a_bing01_dz
	particle_width 12
	particle_height 12
	cull_each false
	renderer billboard
	sorted false
	local_space false
	iteration_interval 0
	nonvisible_update_timeout 0

	billboard_type point
	billboard_origin center
	billboard_rotation_type texcoord
	common_direction 0 0 1
	common_up_vector 0 1 0
	point_rendering false
	accurate_facing false
	speed_relatived_size_factor 0.01

	emitter Box
	{
		angle 0
		colour 1 1 1 1
		colour_range_start 1 1 1 1
		colour_range_end 1 1 1 1
		direction 0 1 0
		emission_rate 20
		position 0 0 0
		velocity 1
		velocity_min 1
		velocity_max 60
		time_to_live 1
		time_to_live_min 1
		time_to_live_max 1.5
		duration 0
		duration_min 0
		duration_max 0
		repeat_delay 0
		repeat_delay_min 0
		repeat_delay_max 0
		width 50
		height 60
		depth 30
	}

	affector ColourFading
	{
		colour0 0 0 0 1
		time0 0
		colour1 0.52549 0.960784 1 1
		time1 0.3
		colour2 0.243137 0.886275 1 1
		time2 0.6
		colour3 0 0 0 1
		time3 1
		colour4 0.5 0.5 0.5 0
		time4 1
		colour5 0.5 0.5 0.5 0
		time5 1
		repeat_times 2
		opacity 1
		fade_in_time 0
		fade_out_time 1
	}

	affector ScaleInterpolator
	{
		uniform_size true
		width_range_start 15
		width_range_end 15
		height_range_start 15
		height_range_end 15
		use_constant_scale false
		constant_scale 1 1 1
		use_interpolated_scale true
		scale0 1 1 1
		time0 0.15
		scale1 6 6 6
		time1 0.3
		scale2 1 1 1
		time2 0.35
		scale3 1 1 1
		time3 1
		scale4 1 1 1
		time4 1
		scale5 1 1 1
		time5 1
		repeat_times 1
	}

}


