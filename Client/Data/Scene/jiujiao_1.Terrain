    <pixmap bottom="0.5" left="0" right="0.5" textureId="1" top="0.25"/>
    <pixmap bottom="1" left="0" right="0.5" textureId="1" top="0.75"/>
    <pixmap bottom="0.25" left="0.5" right="1" textureId="1" top="0"/>
    <pixmap bottom="0.5" left="0.5" right="1" textureId="1" top="0.25"/>
    <pixmap bottom="0.75" left="0.5" right="1" textureId="1" top="0.5"/>
    <pixmap bottom="1" left="0.5" right="1" textureId="1" top="0.75"/>
    <pixmap bottom="0.25" left="0" right="0.5" textureId="2" top="0"/>
    <pixmap bottom="0.5" left="0" right="0.5" textureId="2" top="0.25"/>
    <pixmap bottom="0.75" left="0" right="0.5" textureId="2" top="0.5"/>
    <pixmap bottom="1" left="0" right="0.5" textureId="2" top="0.75"/>
    <pixmap bottom="0.25" left="0.5" right="1" textureId="2" top="0"/>
    <pixmap bottom="0.5" left="0.5" right="1" textureId="2" top="0.25"/>
    <pixmap bottom="0.75" left="0.5" right="1" textureId="2" top="0.5"/>
    <pixmap bottom="1" left="0.5" right="1" textureId="2" top="0.75"/>
    <pixmap bottom="1" left="0" right="0.5" textureId="3" top="0"/>
