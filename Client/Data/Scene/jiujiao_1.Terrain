<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Terrain name="jiujiao_1" tileSize="32" xsize="64" zsize="64">

  <scale x="100" y="100" z="100"/>

  <heightmap filename="jiujiao_1.Heightmap" type="standard"/>

  <gridInfo filename="jiujiao_1.GridInfo" type="standard"/>

  <lightmap filename="jiujiao_1.lightmap.png" type="image"/>

  <textures>
