material 长剑
{
    technique
    {
        pass
        {
            ambient 1.0 1.0 1.0
            diffuse 1.0 1.0 1.0
            specular 0.588235 0.588235 0.588235 0.0
            emissive 0.0 0.0 0.0
            texture_unit
            {
                texture jpg_龙渊剑.dds 
            }
        }
    }
}

