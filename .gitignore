# Runtime output and local backups.
*.log
*.dmp
*.tmp
*.bak
/tlbb/Server/Log/*
!/tlbb/Server/Log/.gitkeep

# Local client account and character caches.
/Client/Accounts/

# Local client logs and launcher runtime data.
/Client/Bin/CEGUI.log
/Client/Bin/Fairy.log
/Client/Bin/Game.log
/Client/Bin64/CEGUI.log
/Client/Bin64/Fairy.log
/Client/Bin64/Game.log
/Client/Launch.log
/Client/Launch.bin

# Local IDA databases and working files.
*.i64
*.idb
*.id0
*.id1
*.id2
*.nam
*.til

# Local secrets and Windows metadata.
.env
.env.*
!.env.example
Thumbs.db
Desktop.ini

# The repository ships the expanded MariaDB directory.
/TLBB_Env/mariadb-10.11.18-winx64.zip
