material 圣诞节骑乘
{
    technique
    {
        pass
        {
            emissive 0.500000 0.500000 0.500000
            alpha_rejection greater 128
            texture_unit
            {
                texture tga_圣诞节骑乘.dds 
            }
        }
    }
}

