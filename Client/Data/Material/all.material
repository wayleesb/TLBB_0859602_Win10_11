material 大竹
{
	technique 
	{
		pass 0
		{
			specular 0.588235 0.588235 0.588235 1 19.2
			scene_blend alpha_blend
			alpha_rejection greater 128

			texture_unit 0
			{
				texture 0树木/tga_大竹.dds
			}
		}

	}

}
