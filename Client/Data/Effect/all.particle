	material wq_dadao10a_kanghuo01
	particle_width 30
	particle_height 30
	cull_each false
	renderer billboard
	sorted false
	local_space true
	iteration_interval 0
	nonvisible_update_timeout 0

	billboard_type point
	billboard_origin center
	billboard_rotation_type vertex
	common_direction 0 0 1
	common_up_vector 0 1 0
	point_rendering false
	accurate_facing false
	speed_relatived_size_factor 0.01

	emitter Box
	{
		angle 180
		colour 1 1 1 1
		colour_range_start 1 1 1 1
		colour_range_end 1 1 1 1
		direction 0 1 0
		emission_rate 15
		position 0 0 0
		velocity 3
		velocity_min 3
		velocity_max 3
		time_to_live 2
		time_to_live_min 2
		time_to_live_max 2
		duration 0
		duration_min 0
		duration_max 0
		repeat_delay 0
		repeat_delay_min 0
		repeat_delay_max 0
		width 10
		height 10
		depth 100
	}

	affector ColourFading
	{
		colour0 0 0 0 1
		time0 0
		colour1 0.8 0.4 0 1
		time1 0.3
		colour2 0.776471 0.156863 0.031373 1
		time2 0.6
		colour3 0 0 0 1
		time3 1
		colour4 0.5 0.5 0.5 0
		time4 1
		colour5 0.5 0.5 0.5 0
		time5 1
		repeat_times 1
		opacity 1
		fade_in_time 0
		fade_out_time 1
	}

	affector Rotator
	{
		rotation_speed_range_start 0
		rotation_speed_range_end 0
		rotation_range_start 0
		rotation_range_end 360
	}

	affector ScaleInterpolator
	{
		uniform_size true
		width_range_start 30
		width_range_end 30
		height_range_start 30
		height_range_end 30
		use_constant_scale false
		constant_scale 1 1 1
		use_interpolated_scale true
		scale0 1 1 1
		time0 0
		scale1 0.5 0.5 0.5
		time1 1
		scale2 1 1 1
		time2 1
		scale3 1 1 1
		time3 1
		scale4 1 1 1
		time4 1
		scale5 1 1 1
		time5 1
		repeat_times 1
	}

}


