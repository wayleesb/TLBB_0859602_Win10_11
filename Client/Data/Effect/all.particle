a00-009
{
	quota 10
	material yanhuo_RMB08_02
	particle_width 10
	particle_height 10
	cull_each false
	renderer billboard
	sorted false
	local_space true
	iteration_interval 0
	nonvisible_update_timeout 0

	billboard_type point
	billboard_origin center
	billboard_rotation_type texcoord
	common_direction 0 0 1
	common_up_vector 0 1 0
	point_rendering false
	accurate_facing false
	speed_relatived_size_factor 0.01

	emitter Ring
	{
		angle 180
		colour 1 1 1 1
		colour_range_start 1 1 1 1
		colour_range_end 1 1 1 1
		direction 0 0 1
		emission_rate 100
		position 0 0 0
		velocity 50
		velocity_min 50
		velocity_max 50
		time_to_live 1
		time_to_live_min 1
		time_to_live_max 1
		duration 1
		duration_min 1
		duration_max 1
		repeat_delay 5
		repeat_delay_min 5
		repeat_delay_max 5
		width 1
		height 1
		depth 1
		inner_width 0.5
		inner_height 0.5
	}

	affector ScaleInterpolator
	{
		uniform_size true
		width_range_start 50
		width_range_end 50
		height_range_start 50
		height_range_end 50
		use_constant_scale false
		constant_scale 1 1 1
		use_interpolated_scale true
		scale0 0 0 0
		time0 0
		scale1 4 4 4
		time1 0.2
		scale2 0 0 0
		time2 0.3
		scale3 1 1 1
		time3 1
		scale4 1 1 1
		time4 1
		scale5 1 1 1
		time5 1
		repeat_times 1
	}

	affector ColourFading
	{
		colour0 0 0 0 1
		time0 0
		colour1 1 0.117647 0.117647 1
		time1 0.3
		colour2 0 0 0 1
		time2 0.7
		colour3 0 0 0 1
		time3 1
		colour4 0 0 0 1
		time4 1
		colour5 0 0 0 1
		time5 1
		repeat_times 1
		opacity 2
		fade_in_time 0
		fade_out_time 1
	}

}


